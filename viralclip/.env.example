# Copy to .env and fill in. Never commit .env.

# --- backend ---
DATABASE_URL=sqlite:///./data/viralclip.db        # or postgresql+psycopg://user:pass@localhost/viralclip
VC_DATA_DIR=./data                                 # uploads, renders, thumbnails
VC_MAX_UPLOAD_GB=20
VC_MIN_FREE_GB=2
VC_ALLOW_SIGNUP=true                               # set false after creating your account
APP_URL=http://localhost:3000                      # https:// => Secure cookies
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# --- AI (Phase 2+) ---
WHISPER_MODEL=small                                # tiny|base|small|medium|large-v3
WHISPER_DEVICE=auto                                # auto|cpu|cuda
LLM_BASE_URL=                                      # e.g. http://localhost:11434/v1 (Ollama). Empty = heuristic scorer
LLM_MODEL=                                         # e.g. qwen2.5:7b-instruct

# --- YouTube (see docs/YOUTUBE_SETUP.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
TOKEN_ENCRYPTION_KEY=                              # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
                                                   # empty = auto-generated key file in VC_DATA_DIR (local use only)
YOUTUBE_DAILY_UPLOAD_LIMIT=6                       # uploads per channel per Pacific day (~1,600 quota units each)
YOUTUBE_DAILY_QUOTA=10000                          # quota units/day of the OAuth (upload) Cloud project

# --- Similar-Shorts research for titles/hashtags (see docs/SETUP_GUIDE.md, Part 3b) ---
YOUTUBE_RESEARCH_API_KEY=                          # plain API key, ideally from a SECOND Cloud project (own quota)
                                                   # empty = use the connected channel's OAuth quota, only while uploads leave room
YOUTUBE_RESEARCH_DAILY_SEARCHES=                   # empty = 90 with a research key, 20 when sharing the upload project

# --- Twitch (see docs/TWITCH_SETUP.md) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/api/twitch/callback

# --- TikTok (see docs/TIKTOK_SETUP.md) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/tiktok/callback   # TikTok likely requires https: see the doc for a tunnel
TIKTOK_AUDITED=false                               # false: direct posts are private (SELF_ONLY) only; drafts are the default
TIKTOK_DAILY_POST_LIMIT=15                         # posts per TikTok account per UTC day

# --- rendering ---
RENDER_PRESET=veryfast                             # x264 preset: veryfast is the tested default; slower = smaller files
RENDER_CRF=18                                      # quality: lower = better (17-20 is visually lossless territory)

# --- frontend ---
BACKEND_URL=http://127.0.0.1:8000
