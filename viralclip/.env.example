# Copy to .env and fill in. Never commit .env.

# --- backend ---
DATABASE_URL=sqlite:///./data/viralclip.db        # or postgresql+psycopg://user:pass@localhost/viralclip
VC_DATA_DIR=./data                                 # uploads, renders, thumbnails
VC_MAX_UPLOAD_GB=20
VC_MIN_FREE_GB=2
VC_ALLOW_SIGNUP=true                               # set false after creating your account
APP_URL=http://localhost:3000                      # https:// => Secure cookies
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# --- AI (Phase 2+) ---
WHISPER_MODEL=small                                # tiny|base|small|medium|large-v3
WHISPER_DEVICE=auto                                # auto|cpu|cuda
LLM_BASE_URL=                                      # e.g. http://localhost:11434/v1 (Ollama). Empty = heuristic scorer
LLM_MODEL=                                         # e.g. qwen2.5:7b-instruct

# --- YouTube (Phase 5+) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
TOKEN_ENCRYPTION_KEY=                              # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- frontend ---
BACKEND_URL=http://127.0.0.1:8000
